<?php

use Drupal\Core\Database\Database;
use Drupal\Core\Mail\MailManagerInterface;
use Drupal\Core\StringTranslation\StringTranslationTrait;
use Drupal\user\Entity\User;
use Drupal\Core\Link;
use Drupal\Core\Url;


function scilab_case_study_mail($key, &$message, $params)
{
    $user = \Drupal::currentUser();
    $language = $message['language'];
    
    //$language = user_preferred_language($user);
    switch ($key) {
        case 'case_study_proposal_received':
  // Initialize data.
  $query = Database::getConnection()->select('case_study_proposal', 'csp');
  $query->fields('csp');
  $query->condition('id', $params['case_study_proposal_received']['result1']);
  $query->range(0, 1);
  $proposal_data = $query->execute()->fetchObject();

  $user = User::load($params['case_study_proposal_received']['user_id']);
  $message['headers'] = $params['case_study_proposal_received']['headers'];

  // Load site name from config.
  $site_name = \Drupal::config('system.site')->get('name') ?? '';

  // Set message subject.
  $message['subject'] = t('[@site_name][Case Study Project] Your Case Study Project proposal has been received',
    ['@site_name' => $site_name]
  );

  // Set message body.
  $message['body'] = [
    'body' => t(
      'Dear @contributor_name,

We have received your Case Study Project proposal with the following details:

Full Name: @name_title @contributor_name
Email: @user_mail
University/Institute: @university
City: @city
State: @state
Country: @country
Project Title: @project_title
Date of Proposal: @creation_date
Expected Date of Completion: @expected_date

Your proposal is under review. You will soon receive an email when it has been approved/disapproved.

Best Wishes,
@site_name Team,
FOSSEE, IIT Bombay',
      [
        '@contributor_name' => $proposal_data->contributor_name ?? '',
        '@name_title' => $proposal_data->name_title ?? '',
        '@user_mail' => $user->getEmail() ?? '',
        '@university' => $proposal_data->university ?? '',
        '@city' => $proposal_data->city ?? '',
        '@state' => $proposal_data->state ?? '',
        '@country' => $proposal_data->country ?? '',
        '@project_title' => $proposal_data->project_title ?? '',
        '@creation_date' => \Drupal::service('date.formatter')->format($proposal_data->creation_date ?? 0, 'custom', 'd/m/Y'),
        '@expected_date' => \Drupal::service('date.formatter')->format($proposal_data->expected_date_of_completion ?? 0, 'custom', 'd/m/Y'),
        '@site_name' => $site_name,
      ]
    ),
  ];

  break;
        case 'case_study_proposal_disapproved':
            /* initializing data */
            $site_name = \Drupal::config('system.site')->get('name') ?? '';

// Database query to fetch proposal data
$query = Database::getConnection()->select('case_study_proposal', 'csp');
$query->fields('csp');
$query->condition('id', $params['case_study_proposal_disapproved']['proposal_id']);
$query->range(0, 1);
$proposal_data = $query->execute()->fetchObject();

// Load user data
$user_data = User::load($params['case_study_proposal_disapproved']['user_id']);

// Prepare message headers
$message['headers'] = $params['case_study_proposal_disapproved']['headers'];

// Set message subject with translation
$message['subject'] = t('[@site_name][Case Study Project] Your Case Study Project proposal has been disapproved',
  ['@site_name' => $site_name]
);

// Set message body with translation and placeholders
$message['body'] = [
  'body' => t(
    'Dear @contributor_name,

We regret to inform you that your Case Study proposal with the following details has been disapproved:

Full Name: @name_title @contributor_name
Email: @user_mail
University/Institute: @university
City: @city
State: @state
Country: @country
Project Title: @project_title
Date of Proposal: @creation_date
Expected Date of Completion: @expected_date

Reason for rejection: @dissapproval_reason

You are welcome to submit a new proposal.

Best Wishes,
@site_name Team,
FOSSEE, IIT Bombay',
    [
      '@contributor_name' => $proposal_data->contributor_name ?? '',
      '@name_title' => $proposal_data->name_title ?? '',
      '@user_mail' => $user_data->getEmail() ?? '',
      '@university' => $proposal_data->university ?? '',
      '@city' => $proposal_data->city ?? '',
      '@state' => $proposal_data->state ?? '',
      '@country' => $proposal_data->country ?? '',
      '@project_title' => $proposal_data->project_title ?? '',
      '@creation_date' => \Drupal::service('date.formatter')->format($proposal_data->creation_date ?? 0, 'custom', 'd/m/Y'),
      '@expected_date' => \Drupal::service('date.formatter')->format($proposal_data->expected_date_of_completion ?? 0, 'custom', 'd/m/Y'),
      '@dissapproval_reason' => $proposal_data->dissapproval_reason ?? '',
      '@site_name' => $site_name,
    ]
  ),
];

break;
        case 'case_study_proposal_approved':
            /* initializing data */
            $site_name = \Drupal::config('system.site')->get('name') ?? '';

// Database query to fetch proposal data
            $query = Database::getConnection()->select('case_study_proposal', 'csp');
            $query->fields('csp');
            $query->condition('id', $params['case_study_proposal_approved']['proposal_id']);
            $query->range(0, 1);
            $proposal_data = $query->execute()->fetchObject();

            // Load user data
            $user_data = User::load($params['case_study_proposal_approved']['user_id']);

            // Prepare message headers
            $message['headers'] = $params['case_study_proposal_approved']['headers'];

            // Set message subject with translation
            $message['subject'] = t(
            '[@site_name][Case Study Project] Your Case Study Project proposal has been approved',
            ['@site_name' => $site_name]
            );

            // Prepare the URL for file upload
            $upload_url = Url::fromUri('https://scilab.in/case-study-project/abstract-code');

            // Set message body with translation and placeholders
            $message['body'] = [
            'body' => t(
'Dear @contributor_name,

Your Case Study Project proposal with the following details has been approved:

Full Name: @name_title @contributor_name
Email: @user_mail
University/Institute: @university
City: @city
State: @state
Country: @country
Project Title: @project_title
Date of Proposal: @creation_date
Expected Date of Completion: @expected_date

You can upload your project files at: @upload_url

Best Wishes,
@site_name Team,
FOSSEE, IIT Bombay',
    [
    '@contributor_name' => $proposal_data->contributor_name ?? '',
    '@name_title' => $proposal_data->name_title ?? '',
    '@user_mail' => $user_data->getEmail() ?? '',
    '@university' => $proposal_data->university ?? '',
    '@city' => $proposal_data->city ?? '',
    '@state' => $proposal_data->state ?? '',
    '@country' => $proposal_data->country ?? '',
    '@project_title' => $proposal_data->project_title ?? '',
    '@creation_date' => \Drupal::service('date.formatter')->format($proposal_data->creation_date ?? 0, 'custom', 'd/m/Y'),
    '@expected_date' => \Drupal::service('date.formatter')->format($proposal_data->expected_date_of_completion ?? 0, 'custom', 'd/m/Y'),
    '@upload_url' => $upload_url->toString(),
    '@site_name' => $site_name,
    ]
),
];
            break;
        case 'case_study_proposal_completed':
            /* initializing data */
            $site_name = \Drupal::config('system.site')->get('name') ?? '';

// Create URL object for the published case study link
$case_study_url = Url::fromUri('https://scilab.in/case-study-project/completed-case-studies');

// Database query to fetch proposal data
$query = Database::getConnection()->select('case_study_proposal', 'csp');
$query->fields('csp');
$query->condition('id', $params['case_study_proposal_completed']['proposal_id']);
$query->range(0, 1);
$proposal_data = $query->execute()->fetchObject();

// Load user data
$user_data = User::load($params['case_study_proposal_completed']['user_id']);

// Prepare message headers
$message['headers'] = $params['case_study_proposal_completed']['headers'];

// Set message subject with translation
$message['subject'] = t(
  '[@site_name][Case Study Project] Your case study project has been approved and marked as completed',
  ['@site_name' => $site_name]
);

// Set message body with translation and placeholders
$message['body'] = [
  'body' => t(
    'Dear @contributor_name,

We are glad to inform you that your files are approved and the Case Study Project with the following details is marked as Completed. The case study is published at @case_study_url

Full Name: @name_title @contributor_name
Email: @user_mail
University/Institute: @university
City: @city
State: @state
Country: @country
Project Title: @project_title

Best Wishes,
@site_name Team,
FOSSEE, IIT Bombay',
    [
      '@contributor_name' => $proposal_data->contributor_name ?? '',
      '@name_title' => $proposal_data->name_title ?? '',
      '@user_mail' => $user_data->getEmail() ?? '',
      '@university' => $proposal_data->university ?? '',
      '@city' => $proposal_data->city ?? '',
      '@state' => $proposal_data->state ?? '',
      '@country' => $proposal_data->country ?? '',
      '@project_title' => $proposal_data->project_title ?? '',
      '@case_study_url' => $case_study_url->toString(),
      '@site_name' => $site_name,
    ]
  ),
];

            break;
        case 'case_study_proposal_send_reminder_mail':
            /* initializing data */
            $site_name = \Drupal::config('system.site')->get('name') ?? '';

// Database query to fetch proposal data
$query = Database::getConnection()->select('case_study_proposal', 'csp');
$query->fields('csp');
$query->condition('id', $params['case_study_proposal_send_reminder_mail']['proposal_id']);
$query->range(0, 1);
$proposal_data = $query->execute()->fetchObject();

// Load user data
$user_data = User::load($params['case_study_proposal_send_reminder_mail']['user_id']);

// Prepare message headers
$message['headers'] = $params['case_study_proposal_send_reminder_mail']['headers'];

// Set message subject with translation
$message['subject'] = t(
  '[@site_name][Case Study Project] Completion date of your proposed Case Study is approaching',
  ['@site_name' => $site_name]
);

// Set message body with translation and placeholders
$message['body'] = [
  'body' => t(
    'Dear @contributor_name,

This is a gentle reminder regarding the proposed case study project. The submission deadline is approaching, and we kindly request you to complete your submission before the deadline.

Please note that once the deadline passes, the interface will no longer accept submissions. Ensure you submit your work on time to avoid any inconvenience.

Best Wishes,

@site_name Team,
FOSSEE, IIT Bombay',
    [
      '@contributor_name' => $proposal_data->contributor_name ?? '',
      '@site_name' => $site_name,
    ]
  ),
];

break;

            break;
        case 'case_study_proposal_deleted':
            /* initializing data */
            $query = \Drupal::database()->select('case_study_proposal');
            $query->fields('case_study_proposal');
            $query->condition('id', $params['case_study_proposal_deleted']['proposal_id']);
            $query->range(0, 1);
            $proposal_data = $query->execute()->fetchObject();
            $user_data = \Drupal::entityTypeManager()->getStorage('user')->load($params['case_study_proposal_deleted']['user_id']);
            $message['headers'] = $params['case_study_proposal_deleted']['headers'];
            

 $site_name = \Drupal::config('system.site')->get('name') ?? '';

// Database query to fetch proposal data
$query = Database::getConnection()->select('case_study_proposal', 'csp');
$query->fields('csp');
$query->condition('id', $params['case_study_proposal_deleted']['proposal_id']);
$query->range(0, 1);
$proposal_data = $query->execute()->fetchObject();

// Load user data
$user_data = User::load($params['case_study_proposal_deleted']['user_id']);

// Prepare message headers
$message['headers'] = $params['case_study_proposal_deleted']['headers'];

// Set message subject with translation
$message['subject'] = t(
  '[@site_name][Case Study Project] Your Case Study Project proposal has been deleted',
  ['@site_name' => $site_name]
);

// Set message body with translation and placeholders
$message['body'] = [
  'body' => t(
    'Dear @contributor_name,

We regret to inform you that your Case Study Project proposal with the following details has been deleted:

Full Name: @name_title @contributor_name
Email: @user_mail
University/Institute: @university
City: @city
State: @state
Country: @country
Project Title: @project_title

You can propose a new Case Study project.

Best Wishes,
@site_name Team,
FOSSEE, IIT Bombay',
    [
      '@contributor_name' => $proposal_data->contributor_name ?? '',
      '@name_title' => $proposal_data->name_title ?? '',
      '@user_mail' => $user_data->getEmail() ?? '',
      '@university' => $proposal_data->university ?? '',
      '@city' => $proposal_data->city ?? '',
      '@state' => $proposal_data->state ?? '',
      '@country' => $proposal_data->country ?? '',
      '@project_title' => $proposal_data->project_title ?? '',
      '@site_name' => $site_name,
    ]
  ),
];

            break;
        /**************************************************************/
        case 'abstract_uploaded':

// Load site name from configuration
$site_name = \Drupal::config('system.site')->get('name') ?? '';

// Database query to fetch proposal data
$query = Database::getConnection()->select('case_study_proposal', 'csp');
$query->fields('csp');
$query->condition('id', $params['abstract_uploaded']['proposal_id']);
$query->range(0, 1);
$proposal_data = $query->execute()->fetchObject();

// Load user data
$user = User::load($params['abstract_uploaded']['user_id']);

// Prepare message headers
$message['headers'] = $params['abstract_uploaded']['headers'];

// Set message subject with translation
$message['subject'] = t(
  '[@site_name][Case Study Project] You have uploaded Case Study project files',
  ['@site_name' => $site_name]
);

// Set message body with translation and placeholders
$message['body'] = [
  'body' => t(
    'Dear @contributor_name,

You have uploaded the following Abstract and Project files:

Project Title: @project_title

The abstract and project files are under review. You will be notified when it has been approved.

Best Wishes,
@site_name Team,
FOSSEE, IIT Bombay',
    [
      '@contributor_name' => $proposal_data->contributor_name ?? '',
      '@project_title' => $proposal_data->project_title ?? '',
      '@site_name' => $site_name,
    ]
  ),
];

break;
        case 'solution_approved':
          
// Database query to fetch proposal data
$query = Database::getConnection()->select('case_study_proposal', 'csp');
$query->fields('csp');
$query->condition('id', $params['solution_approved']['proposal_id']);
$query->range(0, 1);
$proposal_data = $query->execute()->fetchObject();

// Load user data
//$user = User::load($params['solution_approved']['user_id']);

// Prepare message headers
$message['headers'] = $params['solution_approved']['headers'];
           // Load site name from configuration
$site_name = \Drupal::config('system.site')->get('name') ?? '';

// Email subject with translation
$message['subject'] = t(
  '[@site_name][Case Study Project] Your uploaded case study project has been approved',
  ['@site_name' => $site_name]
);

// Email body with translation and placeholders
$message['body'] = [
  'body' => t(
    'Dear @contributor_name,

Your uploaded abstract for the case study project has been approved:

Title of case study project: @project_title

Best Wishes,
@site_name Team,
FOSSEE, IIT Bombay',
    [
      '@contributor_name' => $proposal_data->contributor_name ?? '',
      '@project_title' => $proposal_data->project_title ?? '',
      '@site_name' => $site_name,
    ]
  )
];

              break;

case 'solution_resubmission': 
  $query = Database::getConnection()->select('case_study_proposal', 'csp');
$query->fields('csp');
$query->condition('id', $params['solution_resubmission']['proposal_id']);
$query->range(0, 1);
$proposal_data = $query->execute()->fetchObject();

// Load user data
//$user = User::load($params['solution_approved']['user_id']);

// Prepare message headers
$message['headers'] = $params['solution_resubmission']['headers'];
           // Load site name from configuration
$site_name = \Drupal::config('system.site')->get('name') ?? '';

// Email subject with translation
$message['subject'] = t(
  '[@site_name][Case Study Project] Your uploaded Case Study Project have been marked as pending',
  ['@site_name' => $site_name]
);

// Email body with translation and placeholders
$message['body'] = [
  'body' => t(
'Dear @contributor_name,

Kindly resubmit the project files for the project : @project_title
Reason for resubmission: @disapproval_message

Best Wishes,
@site_name Team,
FOSSEE, IIT Bombay',
    [
      '@contributor_name' => $proposal_data->contributor_name ?? '',
      '@project_title' => $proposal_data->project_title ?? '',
      '@disapproval_message' => $params['solution_resubmission']['disapproval_message'],
      '@site_name' => $site_name,
    ]
  )
];

              break;
case 'solution_disapproved': 
  //var_dump($params['solution_disapproved']['proposal_id']);die;
 $query = Database::getConnection()->select('case_study_proposal', 'csp');
$query->fields('csp');
$query->condition('id', $params['solution_disapproved']['proposal_id']);
$query->range(0, 1);
$proposal_data = $query->execute()->fetchObject();
//var_dump($proposal_data->contributor_name);die;
// Load user data
//$user = User::load($params['solution_approved']['user_id']);

// Prepare message headers
$message['headers'] = $params['solution_disapproved']['headers'];
           // Load site name from configuration
$site_name = \Drupal::config('system.site')->get('name') ?? '';

// Email subject with translation
$message['subject'] = t(
  '[@site_name][Case Study Project] Your uploaded Case Study Project have been marked as disapproved',
  ['@site_name' => $site_name]
);

// Email body with translation and placeholders
$message['body'] = [
  'body' => t(
'Dear @contributor_name,

Your uploaded Case Study Project files for the Case Study Project Title : @project_title have been marked disapproved and deleted. 
Reason for disapproval: @disapproval_message

Best Wishes,
@site_name Team,
FOSSEE, IIT Bombay',
    [
      '@contributor_name' => $proposal_data->contributor_name,
      '@project_title' => $proposal_data->project_title,
      '@disapproval_message' => $params['solution_disapproved']['disapproval_message'],
      '@site_name' => $site_name,
    ]
  )
];

              break;
/**************************************************************/
        case 'abstract_edit_file_uploaded':
            // $solution_q = db_query("SELECT * FROM {case_study_solution} WHERE id = %d LIMIT 1", $params['abstract_uploaded']['solution_id']);
            $site_name = \Drupal::config('system.site')->get('name') ?? '';

// Database query to fetch proposal data
$query = Database::getConnection()->select('case_study_proposal', 'csp');
$query->fields('csp');
$query->condition('id', $params['abstract_edit_file_uploaded']['proposal_id']);
$query->range(0, 1);
$proposal_data = $query->execute()->fetchObject();

// Load user data
//$user = User::load($params['abstract_edit_file_uploaded']['user_id']);

// Get file names from parameters
$abs_file_name = $params['abstract_edit_file_uploaded']['abs_file'] ?? '';
$proj_file_name = $params['abstract_edit_file_uploaded']['proj_file'] ?? '';

// Prepare message headers
$message['headers'] = $params['abstract_edit_file_uploaded']['headers'];

// Set message subject with translation
$message['subject'] = t(
  '[@site_name][Case Study Project] Project files/abstract of a case study updated by Scilab Team',
  ['@site_name' => $site_name]
);

// Set message body with translation and placeholders
$message['body'] = [
  'body' => t(
'Dear @contributor_name,

Our team has updated the abstract/project files for the following case study:

Project Title: @project_title
@abs_file
@proj_file

Best Wishes,
@site_name Team,
FOSSEE, IIT Bombay',
    [
      '@contributor_name' => $proposal_data->contributor_name ?? '',
      '@project_title' => $proposal_data->project_title ?? '',
      '@abs_file' => !empty($abs_file_name) ? t('Updated Abstract File: @file', ['@file' => $abs_file_name]) : '',
      '@proj_file' => !empty($proj_file_name) ? t('Updated Project File: @file', ['@file' => $proj_file_name]) : '',
      '@site_name' => $site_name,
    ]
  ),
];

break;
        case 'standard':
            $message['subject'] = $params['standard']['subject'];
            $message['body'] = $params['standard']['body'];
            $message['headers'] = $params['standard']['headers'];
            break;
    } //$key
}
